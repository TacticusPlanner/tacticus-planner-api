<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TacticusPlanner.Api</RootNamespace>
    <UserSecretsId>tacticus-planner-api-local</UserSecretsId>
    <ContainerDefaultOS>Linux</ContainerDefaultOS>
    <!-- Workstation GC: the API runs in a 0.5 vCPU / 1 GiB container, where Server GC (the Web SDK default) ran
         4 heaps and never compacted gen2, so fragmentation and committed memory grew with uptime. The heap limit
         and compaction settings are in the Dockerfile. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\..\artifacts\openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" />
    <PackageReference Include="Microsoft.FeatureManagement" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="PostHog.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Vogen" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local-only settings (dev keys, localhost URLs) must not ship in the published image. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\orchestration\TacticusPlanner.ServiceDefaults\TacticusPlanner.ServiceDefaults.csproj" />
    <ProjectReference Include="..\TacticusPlanner.Domain\TacticusPlanner.Domain.csproj" />
    <ProjectReference Include="..\TacticusPlanner.GameCatalog\TacticusPlanner.GameCatalog.csproj" />
    <ProjectReference Include="..\TacticusPlanner.Persistence\TacticusPlanner.Persistence.csproj" />
    <ProjectReference Include="..\TacticusPlanner.TacticusApi\TacticusPlanner.TacticusApi.csproj" />
  </ItemGroup>
</Project>
