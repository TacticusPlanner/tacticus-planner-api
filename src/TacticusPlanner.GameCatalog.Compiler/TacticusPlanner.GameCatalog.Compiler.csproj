<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the game catalog from the raw data at build time: datamine readers, denormalizers, validators, hashes.
       TacticusPlanner.GameCatalog runs it during its build and embeds the output; it is never shipped. The root
       namespace keeps the embedded resource names (and so the derived release version) as they were. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TacticusPlanner.GameCatalog</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TacticusPlanner.GameCatalog.Models\TacticusPlanner.GameCatalog.Models.csproj" />
    <ProjectReference Include="..\TacticusPlanner.GameDomain\TacticusPlanner.GameDomain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\**\*.json" Exclude="Data\datamine\**" />
    <!-- Datamine copies keep their upstream raw/ path as the resource name (opened by DatamineFiles, never by
         the leaf-name convention, since game leaf names like units.json or items.json repeat). -->
    <EmbeddedResource Include="Data\datamine\raw\**\*.json"
      LogicalName="datamine/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    <!-- The datamine's own game build (e.g. 1.43.157.2989), served as the manifest gameVersion. -->
    <EmbeddedResource Include="Data\datamine\raw\VERSION" LogicalName="datamine/VERSION" />
  </ItemGroup>
</Project>
